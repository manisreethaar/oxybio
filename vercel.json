{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/science",
      "destination": "/platform",
      "statusCode": 301
    },
    {
      "source": "/science.html",
      "destination": "/platform",
      "statusCode": 301
    },
    {
      "source": "/problem",
      "destination": "/platform",
      "statusCode": 301
    },
    {
      "source": "/problem.html",
      "destination": "/platform",
      "statusCode": 301
    },
    {
      "source": "/ingredients",
      "destination": "/platform",
      "statusCode": 301
    },
    {
      "source": "/ingredients.html",
      "destination": "/platform",
      "statusCode": 301
    },
    {
      "source": "/investors",
      "destination": "/about#investors",
      "statusCode": 301
    },
    {
      "source": "/investors.html",
      "destination": "/about#investors",
      "statusCode": 301
    },
    {
      "source": "/life",
      "destination": "/careers",
      "statusCode": 301
    },
    {
      "source": "/life.html",
      "destination": "/careers",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "/updates",
      "statusCode": 301
    },
    {
      "source": "/blog.html",
      "destination": "/updates",
      "statusCode": 301
    },
    {
      "source": "/blog-((?!origin|bootstrapping)[^/]*)",
      "destination": "/updates",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/docs/Privacy_Policy.pdf",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.oxygenbioinnovations.com/privacy>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/assets/docs/Terms_and_Conditions.pdf",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.oxygenbioinnovations.com/terms>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
